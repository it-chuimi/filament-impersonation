{
    "name": "chuimi/filament-impersonation",
    "description": "Controlled user impersonation plugin for Filament applications.",
    "keywords": [
        "laravel",
        "filament",
        "impersonation",
        "user-impersonation",
        "audit",
        "activitylog",
        "spatie",
        "admin-panel"
    ],
    "homepage": "https://github.com/it-chuimi/filament-impersonation",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "CHUIMI",
            "homepage": "https://github.com/it-chuimi"
        }
    ],
    "support": {
        "issues": "https://github.com/it-chuimi/filament-impersonation/issues",
        "source": "https://github.com/it-chuimi/filament-impersonation"
    },
    "autoload": {
        "psr-4": {
            "Chuimi\\FilamentImpersonation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Chuimi\\FilamentImpersonation\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Chuimi\\FilamentImpersonation\\ImpersonationServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0",
        "illuminate/contracts": "^12.0",
        "illuminate/routing": "^12.0",
        "filament/filament": "^5.0",
        "spatie/laravel-activitylog": "^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
